generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SiteProfile {
  id                 String   @id @default("default")
  fullName           String   @default("Sanjana Pandey")
  designation        String   @default("News Reporter | Journalist | News Anchor")
  headline           String   @default("Telling Stories. Reporting Truth. Connecting People.")
  heroIntro          String
  biography          String
  aboutHighlights    String   @default("[]")
  heroImageUrl       String   @default("/images/sanjana-hero.png")
  aboutImageUrl      String   @default("/images/sanjana-about.png")
  resumeUrl          String?
  location           String   @default("Ranchi, Jharkhand, India")
  email              String   @default("[Editable: Email]")
  phone              String   @default("[Editable: Phone Number]")
  instagramUrl       String   @default("")
  linkedinUrl        String   @default("")
  youtubeUrl         String   @default("")
  internshipChannel  String   @default("Global Awaaz News Channel")
  internshipRole     String   @default("News Reporting Intern")
  internshipDuration String   @default("August 2026 – November 2026")
  internshipPoints   String   @default("[]")
  educationJson      String   @default("[]")
  skillsJson         String   @default("[]")
  updatedAt          DateTime @updatedAt
}

model Video {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  description  String
  category     String
  sourceType   String    // "MP4" | "YOUTUBE" | "INSTAGRAM"
  videoUrl     String
  thumbnailUrl String?
  location     String?
  recordedDate DateTime  @default(now())
  featured     Boolean   @default(false)
  visible      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  articles     Article[]
}

model Article {
  id             String    @id @default(cuid())
  slug           String    @unique
  headline       String
  excerpt        String
  content        String
  coverImageUrl  String?
  category       String
  tags           String    @default("[]")
  location       String?
  relatedVideoId String?
  relatedVideo   Video?    @relation(fields: [relatedVideoId], references: [id], onDelete: SetNull)
  published      Boolean   @default(false)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model GalleryImage {
  id        String    @id @default(cuid())
  title     String?
  caption   String
  category  String
  imageUrl  String
  takenDate DateTime?
  visible   Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ContactMessage {
  id           String   @id @default(cuid())
  name         String
  email        String
  organization String?
  subject      String
  message      String
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
