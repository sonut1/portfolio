# =============================================================================
# Production (Vercel) — set these in the Vercel Project Settings > Environment Variables
# =============================================================================

# Database (PostgreSQL required on Vercel — Neon, Supabase, Railway, etc.)
# Example: postgresql://user:password@host:5432/db?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/sanjana_portfolio"

# For local dev only (requires local PostgreSQL): DATABASE_URL="postgresql://user:password@localhost:5432/sanjana_portfolio"

# Admin Authentication (CHANGE these in production!)
AUTH_SECRET="replace-with-a-long-random-secret-32-plus-chars"
ADMIN_EMAIL="admin@sanjanapandey.in"
ADMIN_PASSWORD="ChangeMe@2026!"

# Public Site URL (used for OpenGraph & Share links) — set to your Vercel URL in production
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Media Storage Provider: "local" | "cloudinary" | "supabase"
# On Vercel, use "cloudinary" or "supabase" — "local" will NOT persist (read-only filesystem).
STORAGE_PROVIDER="cloudinary"

# Option A: Cloudinary (recommended for Vercel)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="sanjana-portfolio"

# Option B: Supabase Storage
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="portfolio-media"
